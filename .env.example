# Immich MCP Server Environment Configuration
# Copy this file to .env and update with your actual values.
# NOTE: never commit the real .env - it contains API keys.

# ===== Required - Immich Server Connection =====
IMMICH_SERVER_URL=http://localhost:2283
IMMICH_API_KEY=your_immich_api_key_here

# ===== Optional - Multi-User Mode =====
# Comma-separated user specs: name:api_key:role[:description]
# Example: sandra:key1:admin:Primary,steve:key2:user:Secondary
IMMICH_USERS=
# Active user name from IMMICH_USERS (defaults to the first user)
IMMICH_ACTIVE_USER=

# ===== Optional - Performance Tuning =====
IMMICH_TIMEOUT=30
IMMICH_MAX_RETRIES=3
IMMICH_DEFAULT_LIMIT=50
IMMICH_MAX_LIMIT=200

# ===== Optional - Debug =====
IMMICH_DEBUG=0

# ===== Optional - MCP Bridge =====
# External MCP servers to proxy (comma-separated URLs)
MCP_BRIDGE_URLS=
