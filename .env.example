# Immich MCP Server Environment Configuration
# Copy this file to .env and update with your actual values

# Required - Immich Server Connection
IMMICH_URL=http://localhost:2283
IMMICH_API_KEY=your_immich_api_key_here

# Optional - Server Configuration
MCP_SERVER_NAME="Immich Photo Management MCP 📸"
LOG_LEVEL=INFO

# Optional - Performance Tuning
IMMICH_TIMEOUT=30
MAX_UPLOAD_SIZE_MB=500
CONCURRENT_UPLOADS=5

# Optional - Feature Flags
ENABLE_FACE_DETECTION=true
ENABLE_SMART_SEARCH=true
ENABLE_AUTO_TAGGING=true

# Optional - Austrian/Vienna Context
TIMEZONE=Europe/Vienna
DATE_FORMAT=DD.MM.YYYY
LANGUAGE=de

# Development - Test Environment (optional)
TEST_IMMICH_URL=http://localhost:2283
TEST_IMMICH_API_KEY=your_test_api_key_here

# MCP Bridge - Proxy external MCP servers (comma-separated URLs)
MCP_BRIDGE_URLS=

# Security - Production Settings (optional)
VERIFY_SSL=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600
