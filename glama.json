{
  "$schema": "https://glama.ai/mcp/schemas/server.json",
  "maintainers": [
    "sandraschi"
  ],
  "name": "immich-mcp",
  "id": "immich-mcp",
  "repository": "https://github.com/sandraschi/immich-mcp",
  "description": "FastMCP 3.4+ server for Immich photo library management. Compatible with Immich v2.7+ (verified live) and v3.0.0+/v3.1.x (verified against the official OpenAPI spec). 33 tools: upload, CLIP smart search, OCR search, albums, people/face detection, libraries, multi-user, share links, storage stats, edits.",
  "version": "1.6.2",
  "type": "mcp_server",
  "status": "active",
  "framework": "FastMCP 3.4+",
  "tools": [
    "add_to_album",
    "agentic_immich_workflow",
    "backup_photos",
    "conversational_immich_assistant",
    "create_album",
    "create_library",
    "delete_photos",
    "detect_people",
    "detect_similar_photos",
    "download_photo_to_temp",
    "edit_photo",
    "get_asset_ocr",
    "get_current_user",
    "get_library_info",
    "get_ocr_data",
    "get_storage_info",
    "get_user_libraries",
    "immich_help",
    "immich_shutdown",
    "intelligent_photo_processing",
    "list_albums",
    "list_libraries",
    "list_users",
    "manage_library",
    "organize_photos_by_date",
    "scan_library",
    "search_by_person",
    "search_photos",
    "server_health",
    "share_album",
    "show_server_health_prefab",
    "switch_immich_user",
    "switch_user",
    "sync_metadata_to_exif",
    "tag_person",
    "update_asset_visibility",
    "upload_photos"
  ],
  "transport": [
    "stdio",
    "http"
  ],
  "keywords": [
    "immich",
    "photos",
    "photo-management",
    "library",
    "ocr",
    "face-detection",
    "albums",
    "mcp-server",
    "fastmcp"
  ],
  "features": {
    "photo_management": {
      "enabled": true
    },
    "smart_search": {
      "enabled": true,
      "requires": "Immich ML/CLIP enabled"
    },
    "ocr_search": {
      "enabled": true,
      "requires": "Immich v2.2.0+"
    },
    "api_integration": {
      "enabled": true,
      "api": "Immich API"
    }
  }
}
